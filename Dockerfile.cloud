FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=America/Denver

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-cloud.txt .
RUN pip install --no-cache-dir -r requirements-cloud.txt

# Copy only Python source; never include data, local env, credentials or outputs.
COPY *.py ./
COPY coordination/operator_acks/2026-09-30_ledger_cutover.json ./coordination/operator_acks/

RUN mkdir -p data reports logs

CMD ["python", "morning_inferno_pipeline.py", "--cloud-native"]
